# Postgres credentials. Compose reads .env automatically and passes
# these to the database on first start. Copy this file to .env and
# fill them in. In production these are real secrets.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host port for GUI clients (pgAdmin, DBeaver, TablePlus).
# Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432

# Passed through to the API. Hashes visitor IPs before storage.
# Must be a long random value, and different per environment.
IP_HASH_SALT=

# Host port nginx publishes. The site is reached at http://localhost:PORT
# Development only. compose.prod.yaml publishes 80 and 443 unconditionally.
HTTP_PORT=80

# ---- Production only (compose.prod.yaml) ----
# Ignored in development. compose.prod.yaml requires all of them.

# Image tags to run, as full commit SHAs. Never 'latest': a moving tag
# cannot tell you what is running, and cannot be rolled back to.
# Find them with:
#   gh api repos/gislamog/modulo-world-frontend/commits/main --jq .sha
FRONTEND_IMAGE_TAG=
BACKEND_IMAGE_TAG=

# Absolute public origin. Canonical links and meta tags are built from
# this, so it must be the https apex, with no trailing slash.
PUBLIC_SITE_URL=https://moduloworld.com

# Which nginx server block to mount. Two valid values:
#   nginx.bootstrap.conf  HTTP only, for the first deploy before a
#                         certificate exists
#   nginx.prod.conf       TLS, HSTS, www redirect. The steady state.
# Starts as bootstrap because nginx will not start with an
# ssl_certificate that points at a file that is not there yet.
NGINX_CONF=nginx.bootstrap.conf
