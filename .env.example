# Postgres credentials. Compose reads .env automatically and passes
# these to the database on first start. Copy this file to .env and
# fill them in. In production these are real secrets.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Host port for GUI clients (pgAdmin, DBeaver, TablePlus).
# Change if 5432 is already taken on your machine.
POSTGRES_PORT=5432